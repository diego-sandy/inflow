{
  "name": "inflow-mcp",
  "version": "0.1.0",
  "description": "Local MCP companion for the inflow LinkedIn extension — exposes your inflow toolbox (connections, network stats, and drafting into your Outbox) to Claude Desktop. Claude can read and draft; it never sends — you always send from inflow.",
  "type": "module",
  "bin": {
    "inflow-mcp": "src/index.mjs"
  },
  "files": [
    "src"
  ],
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "claude",
    "linkedin",
    "inflow"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/grinich/inflow.git",
    "directory": "mcp-companion"
  },
  "scripts": {
    "validate": "mcpb validate manifest.json",
    "pack": "mcpb pack . inflow.mcpb"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^1.0.0"
  },
  "license": "MIT"
}
